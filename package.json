{
  "name": "twitter-docs",
  "version": "1.0.0",
  "description": "Documentation site for Twitter CLI",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "deploy": "pnpm docs:build && wrangler deploy",
    "deploy:dry-run": "pnpm docs:build && wrangler deploy --dry-run"
  },
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "dependencies": {
    "vitepress": "^1.6.4"
  },
  "private": true,
  "devDependencies": {
    "wrangler": "4.135.0"
  }
}
